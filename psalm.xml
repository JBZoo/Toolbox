<psalm
        errorLevel="1"
        reportMixedIssues="false"
        useDocblockPropertyTypes="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src"/>

        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <DuplicateClass errorLevel="suppress"/>
        <DuplicateFunction errorLevel="suppress"/>

        <!-- Keep parity with the ecosystem canon (vendor/jbzoo/codestyle/psalm.xml): psalm 6 turned
             unused-code detection on by default, and ./src holds aggregated copies of the JBZoo
             libraries whose public APIs are naturally "unused" inside this meta-package. -->
        <PossiblyUnusedMethod errorLevel="suppress"/>
        <InvalidOperand errorLevel="suppress"/>
        <MissingOverrideAttribute errorLevel="suppress"/>
        <UnusedClass errorLevel="suppress"/>
        <PossiblyUnusedReturnValue errorLevel="suppress"/>

        <!-- Aggregate-context false positives: the same files analyzed in their OWN repos (the
             authoritative per-package gates) are clean; only the aggregated copy triggers these
             (e.g. SimpleXMLElement nullsafe access in ci-report-converter — correct at runtime:
             a missing child IS null). Each package's own gate remains the strict source of truth. -->
        <TypeDoesNotContainNull errorLevel="suppress"/>
        <RedundantCondition errorLevel="suppress"/>
    </issueHandlers>
</psalm>
