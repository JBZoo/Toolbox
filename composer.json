{
    "name"              : "jbzoo/toolbox",
    "description"       : "It directly integrates the entire JBZoo libraries in one place. In the future, it will be the framework.",
    "type"              : "library",
    "license"           : "MIT",
    "keywords"          : [
        "jbzoo",
        "toolbox"
    ],

    "authors"           : [
        {
            "name"  : "Denis Smetannikov",
            "email" : "admin@jbzoo.com",
            "role"  : "lead"
        }
    ],

    "minimum-stability" : "dev",
    "prefer-stable"     : true,

    "require"           : {
        "php"               : "^8.3",
        "ext-dom"           : "*",

        "jbzoo/assets"      : "^8.0",
        "jbzoo/cli"         : "^8.0",
        "jbzoo/data"        : "^8.0",
        "jbzoo/event"       : "^8.0",
        "jbzoo/http-client" : "^8.0",
        "jbzoo/image"       : "^8.0",
        "jbzoo/less"        : "^8.0",
        "jbzoo/markdown"    : "^8.0",
        "jbzoo/mermaid-php" : "^8.0",
        "jbzoo/path"        : "^8.0",
        "jbzoo/retry"       : "^8.0",
        "jbzoo/utils"       : "^8.0",

        "guzzlehttp/guzzle" : ">=7.15.1"
    },

    "require-dev"       : {
        "jbzoo/ci-report-converter" : "^8.0",
        "jbzoo/codestyle"           : "^8.0",
        "jbzoo/composer-diff"       : "^8.0",
        "jbzoo/composer-graph"      : "^8.0",
        "jbzoo/phpunit"             : "^8.0",

        "rmccue/requests"           : ">=2.0.18",
        "roave/security-advisories" : "dev-master"
    },

    "autoload"          : {
        "psr-4" : {"JBZoo\\Toolbox\\" : "src"}
    },

    "autoload-dev"      : {
        "psr-4" : {"JBZoo\\PHPUnit\\" : "tests"}
    },

    "config"            : {
        "optimize-autoloader" : true,
        "allow-plugins"       : {"composer/package-versions-deprecated" : true}
    },

    "extra"             : {
        "branch-alias" : {
            "dev-master" : "8.x-dev"
        }
    }
}
